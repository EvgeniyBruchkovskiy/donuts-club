# Public Firebase web config lives in web/src/config.ts (not secret by design).
# Local dev / e2e only — copy to web/.env.local (gitignored):
VITE_APPCHECK_DEBUG_TOKEN=          # registered in App Check → Manage debug tokens
VITE_E2E_DISABLE_APP_VERIFICATION=  # "1" to skip reCAPTCHA; works only with Firebase test phone numbers
VITE_USE_EMULATORS=                 # "1" to use the local Auth/Functions emulators
# POSTER_TOKEN is NOT here — it lives only in Secret Manager.
